<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bob_startracker</name>
  <version>1.0.0</version>
  <description>Star-tracker calibration of the all-sky fisheye camera: stores star positions found in
    captured night frames and fits a distortion-corrected pixel to true-north azimuth / elevation model.</description>
  <maintainer email="uapbob@gmail.com">Bob Universal Object Tracker</maintainer>
  <license>GPLv3</license>

  <depend>rclpy</depend>
  <depend>cv_bridge</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>bob_interfaces</depend>
  <depend>python3-opencv</depend>
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>
  <!-- PyEphem is installed with pip in the Dockerfile (pip: ephem) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
